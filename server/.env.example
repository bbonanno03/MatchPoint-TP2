# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio.

PORT=8080

# MEM: datos en memoria (tests y desarrollo sin base)
# SUPABASE: datos en la base de Supabase
MODO_PERSISTENCIA=MEM

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usar la "service_role key": el servidor aplica las reglas de negocio y de permisos.
SUPABASE_KEY=TU_SERVICE_ROLE_KEY
